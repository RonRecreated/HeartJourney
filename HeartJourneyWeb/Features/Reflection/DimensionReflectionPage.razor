@page "/journeys/{JourneySlug}/milestones/{MilestoneSlug}/dimensions/{DimensionSlug}"
@using System.Text.Json
@using HeartJourney.Core.Features.Reflection
@using HeartJourney.Core.Services.Interfaces
@using HeartJourneyWeb.Components.Auth
@using HeartJourneyWeb.Services.ReflectionAnswers
@using HeartJourneyWeb.Services.DimensionProgress
@inject IDimensionProgressService DimensionProgressService
@inject IReflectionAnswerService ReflectionAnswerService
@inject IContentRepository ContentRepository

<PageTitle>@(_view?.DimensionTitle ?? "Reflection")</PageTitle>

<RequireAuth>
<section class="reflection-shell">
    @if (_isLoading)
    {
        <p>Loading reflection...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-card">
            <strong>Something went wrong.</strong>
            <p>@_errorMessage</p>
        </div>
    }
    else if (_view is null)
    {
        <p>Reflection not found.</p>
    }
    else if (_pathEnded)
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}")">@_view.JourneyTitle</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}/milestones/{_view.MilestoneSlug}")">@_view.MilestoneTitle</a>
            <span>/</span>
            <span>@_view.DimensionTitle</span>
        </nav>

        <article class="reflection-card completion-card">
            <p class="eyebrow">Reflection outcome</p>

            <h1 class="reflection-question">
                This reflection path is complete for now.
            </h1>

            @if (!string.IsNullOrWhiteSpace(_outcomeMessage))
            {
                <p class="intro-text">@_outcomeMessage</p>
            }
            else
            {
                <p class="intro-text">
                    Based on your answer, this reflection path has reached a natural stopping point.
                    Take a moment to prayerfully consider what this may be showing you.
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(_recommendedMilestoneSlug)
                    && !string.IsNullOrWhiteSpace(_recommendedMilestoneTitle))
            {
                <div class="guidance-card">
                    <strong>Recommended next step</strong>
                    <p>
                        You may want to spend time in the
                        <strong>@_recommendedMilestoneTitle</strong>
                        milestone before continuing deeper here.
                    </p>

                    <a class="secondary-link"
                        href="@($"/journeys/{JourneySlug}/milestones/{_recommendedMilestoneSlug}/intro")">
                            Go to @_recommendedMilestoneTitle
                    </a>
                </div>
            }

            <div class="reflection-actions">
                <a class="secondary-link"
                    href="@($"/journeys/{JourneySlug}/milestones/{MilestoneSlug}")">
                        Back to Growth Areas
                </a>

                <button type="button"
                        class="primary-button"
                        @onclick="RestartCurrentDimensionAsync">
                    Restart This Reflection
                </button>
            </div>
        </article>
    }
    else if (_isComplete)
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}")">@_view.JourneyTitle</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}/milestones/{_view.MilestoneSlug}")">@_view.MilestoneTitle</a>
            <span>/</span>
            <span>@_view.DimensionTitle</span>
        </nav>
        
        <article class="reflection-card completion-card">
            <p class="eyebrow">Reflection complete</p>
            <h1 class="reflection-question">
                You’ve completed this growth area.
            </h1>

            <p class="intro-text">
                You have reached the end of this reflection path for @_view.DimensionTitle.
                Take a moment to consider what stood out, what God may be showing you,
                and what next faithful step you may need to take. When ready, return to your growth areas to continue your journey.
            </p>

            <div class="reflection-actions">
                <a class="secondary-link"
                    href="@($"/journeys/{JourneySlug}/milestones/{MilestoneSlug}")">
                    Back to Growth Areas
                </a>

                <button type="button"
                        class="primary-button"
                        disabled>
                    Insights coming soon
                </button>
            </div>
        </article>
    }
    else if (CurrentPrompt is null)
    {
        <div class="empty-card">
            <h1>No reflection prompt yet</h1>
            <p>
                This dimension does not have a reflection question available yet.
            </p>
        </div>
    }
    // Reflection Card goes here
    else
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}")">@_view.JourneyTitle</a>
            <span>/</span>
            <a href="@($"/journeys/{_view.JourneySlug}/milestones/{_view.MilestoneSlug}")">@_view.MilestoneTitle</a>
            <span>/</span>
            <span>@_view.DimensionTitle</span>
        </nav>

        <article class="reflection-card">
            <div class="reflection-header">
                <p class="eyebrow">
                    @_view.DimensionTitle
                </p>

                <p class="step-indicator">
                    Question @_visibleQuestionNumber
                </p>

                <h1 class="reflection-question">
                    @CurrentPrompt.Question
                </h1>
            </div>

            @if (CurrentPrompt.AnswerOptions.Count == 0)
            {
                <p class="intro-text">
                    No answer options have been added for this question yet.
                </p>
            }
            else
            {
                <div class="answer-list">
                    @foreach (var answer in CurrentPrompt.AnswerOptions)
                    {
                        var isSelected = ReferenceEquals(_selectedAnswer, answer);

                        <button type="button"
                                class="answer-card @(isSelected ? "selected" : null)"
                                @onclick="() => SelectAnswer(answer)">
                            <span class="answer-label">@answer.Label</span>

                            @if (!string.IsNullOrWhiteSpace(answer.Description))
                            {
                                <span class="answer-description">@answer.Description</span>
                            }
                        </button>
                    }
                </div>
            }

            @if (_selectedAnswer is not null
                && !string.IsNullOrWhiteSpace(_selectedAnswer.GuidanceMessage))
            {
                <div class="guidance-card">
                    <strong>Gentle guidance</strong>
                    <p>@_selectedAnswer.GuidanceMessage</p>
                </div>
            }

            @if (CurrentPrompt.AllowNotes)
            {
                <div class="notes-section">
                    <label for="reflectionNotes">
                        @if (!string.IsNullOrWhiteSpace(CurrentPrompt.NotesPrompt))
                        {
                            @CurrentPrompt.NotesPrompt
                        }
                        else
                        {
                            <span>Optional notes</span>
                        }
                    </label>

                    <textarea id="reflectionNotes"
                        @bind="_notes"
                        rows="5"
                        placeholder="Write anything you want to remember from this reflection.">
                    </textarea>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_saveErrorMessage))
            {
                <div class="error-card">
                    <p>@_saveErrorMessage</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_saveMessage))
            {
                <div class="success-card">
                    <p>@_saveMessage</p>
                </div>
            }

            <div class="reflection-actions">
                <div class="reflection-actions-left">
                    <a class="secondary-link"
                        href="@($"/journeys/{JourneySlug}/milestones/{MilestoneSlug}")">
                        Back to Growth Areas
                    </a>

                    @if (_currentPromptIndex > 0)
                    {
                        <button type="button"
                                class="secondary-button"
                                disabled="@(_promptHistory.Count == 0)"
                                @onclick="PreviousPromptAsync">
                            Back
                        </button>
                    }
                </div>

                <button type="button"
                        class="primary-button"
                        disabled="@(_selectedAnswer is null || _isSavingAnswer)"
                        @onclick="SaveAndContinueAsync">
                    @(_isSavingAnswer ? "Saving..." : "Save and Continue")
                </button>
            </div>
        </article>
    }
</section>
</RequireAuth>

@code {
    [Parameter]
    public string JourneySlug { get; set; } = string.Empty;

    [Parameter]
    public string MilestoneSlug { get; set; } = string.Empty;

    [Parameter]
    public string DimensionSlug { get; set; } = string.Empty;

    private DimensionReflectionView? _view;
    private AnswerOptionView? _selectedAnswer;
    private List<ReflectionPromptView> _prompts = new();
    private Dictionary<string, ReflectionAnswerRecord> _savedAnswersByPromptId = new();
    private int _currentPromptIndex;
    private bool _isComplete;
    private bool _isLoading = true;
    private bool _isSavingAnswer;
    private string? _errorMessage;
    private string? _saveMessage;
    private string? _saveErrorMessage;
    private string _notes = string.Empty;
    private bool _pathEnded;
    private string? _outcomeMessage;
    private string? _outcomeKey;
    private string? _progressStatus;
    private string? _recommendedMilestoneSlug;
    private string? _recommendedMilestoneTitle;
    private int _visibleQuestionNumber = 1;
    private DimensionProgressRecord? _dimensionProgress;

    private class PromptHistoryEntry
    {
        public int PromptIndex { get; set; }

        public int VisibleQuestionNumber { get; set; }
    }

    private List<PromptHistoryEntry> _promptHistory = new();

    private ReflectionPromptView? CurrentPrompt =>
    _currentPromptIndex >= 0 && _currentPromptIndex < _prompts.Count
        ? _prompts[_currentPromptIndex]
        : null;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _saveMessage = null;
        _saveErrorMessage = null;
        _selectedAnswer = null;
        _notes = string.Empty;
        _visibleQuestionNumber = 1;
        _promptHistory.Clear();

        ClearPathOutcome();

        try
        {
            _view = await ContentRepository.GetDimensionReflectionBySlugsAsync(
                JourneySlug,
                MilestoneSlug,
                DimensionSlug);

            _prompts = _view?.ReflectionPrompts ?? new List<ReflectionPromptView>();

            if (_prompts.Count == 0 && _view?.ReflectionPrompt is not null)
            {
                _prompts = new List<ReflectionPromptView>
                {
                    _view.ReflectionPrompt
                };
            }

            var promptIds = _prompts
                .Select(prompt => prompt.Id)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct()
                .ToList();

            var savedAnswers = await ReflectionAnswerService.GetAnswersForPromptsAsync(
                promptIds);

            _savedAnswersByPromptId = savedAnswers
                .Where(answer => !string.IsNullOrWhiteSpace(answer.ReflectionPromptId))
                .GroupBy(answer => answer.ReflectionPromptId)
                .ToDictionary(group => group.Key, group => group.First());

            // Load saved dimension progress
            _dimensionProgress = await DimensionProgressService.GetProgressAsync(
                JourneySlug,
                MilestoneSlug,
                DimensionSlug);

            // Decide what to show based on saved progress
            ApplySavedDimensionProgress();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplySavedDimensionProgress()
    {
        if (_dimensionProgress is null)
        {
            MoveToNextPromptFromSavedPath();
            return;
        }

        _visibleQuestionNumber = Math.Max(1, _dimensionProgress.VisibleQuestionNumber);
        RestorePromptHistory(_dimensionProgress.PromptHistoryJson);

        if (_dimensionProgress.Status is "completed" or "redirected" or "needs_guidance")
        {
            _pathEnded = true;
            _isComplete = false;

            _outcomeKey = _dimensionProgress.OutcomeKey;
            _outcomeMessage = _dimensionProgress.OutcomeMessage;
            _progressStatus = _dimensionProgress.Status;
            _recommendedMilestoneSlug = _dimensionProgress.RecommendedMilestoneSlug;
            _recommendedMilestoneTitle = _dimensionProgress.RecommendedMilestoneTitle;

            return;
        }

        if (!string.IsNullOrWhiteSpace(_dimensionProgress.CurrentPromptId))
        {
            var currentIndex = _prompts.FindIndex(prompt =>
                string.Equals(
                    prompt.Id,
                    _dimensionProgress.CurrentPromptId,
                    StringComparison.OrdinalIgnoreCase));

            if (currentIndex >= 0)
            {
                _currentPromptIndex = currentIndex;
                _isComplete = false;

                ClearPathOutcome();
                LoadSavedAnswerForCurrentPrompt();
                return;
            }
        }

        MoveToNextPromptFromSavedPath();
    }

    private void MoveToNextPromptFromSavedPath()
    {
        _selectedAnswer = null;
        _notes = string.Empty;
        _saveMessage = null;
        _saveErrorMessage = null;
        _isComplete = false;

        if (_prompts.Count == 0)
        {
            _currentPromptIndex = 0;
            return;
        }

        var visitedPromptIds = new HashSet<string>();
        var currentPromptIndex = 0;

        while (currentPromptIndex >= 0 && currentPromptIndex < _prompts.Count)
        {
            var prompt = _prompts[currentPromptIndex];

            if (!visitedPromptIds.Add(prompt.Id))
            {
                break;
            }

            if (!_savedAnswersByPromptId.TryGetValue(prompt.Id, out var savedAnswer))
            {
                _currentPromptIndex = currentPromptIndex;
                LoadSavedAnswerForCurrentPrompt();
                return;
            }

            var savedOption = FindAnswerOptionForSavedAnswer(prompt, savedAnswer);

            if (savedOption?.EndsPath == true)
            {
                EndPathFromAnswer(savedOption);
                _currentPromptIndex = currentPromptIndex;
                return;
            }

            if (savedOption is not null)
            {
                var targetedPromptIndex = FindTargetPromptIndex(savedOption);

                if (targetedPromptIndex >= 0)
                {
                    currentPromptIndex = targetedPromptIndex;
                    continue;
                }
            }

            currentPromptIndex++;
        }

        _isComplete = true;
        _currentPromptIndex = _prompts.Count - 1;
    }

    private void LoadSavedAnswerForCurrentPrompt()
    {
        _selectedAnswer = null;
        _notes = string.Empty;

        var prompt = CurrentPrompt;

        if (prompt is null)
        {
            return;
        }

        if (!_savedAnswersByPromptId.TryGetValue(prompt.Id, out var savedAnswer))
        {
            return;
        }

        _selectedAnswer = prompt.AnswerOptions.FirstOrDefault(answer =>
            string.Equals(
                answer.Label,
                savedAnswer.SelectedAnswerLabel,
                StringComparison.OrdinalIgnoreCase));

        _notes = savedAnswer.Notes ?? string.Empty;
    }

    private void SelectAnswer(AnswerOptionView option)
    {
        _selectedAnswer = option;
        _saveMessage = null;
        _saveErrorMessage = null;
    }

    private async Task SaveAndContinueAsync()
    {
        var currentPrompt = CurrentPrompt;
        var selectedAnswer = _selectedAnswer;

        if (_view is null || currentPrompt is null || selectedAnswer is null)
        {
            return;
        }

        _isSavingAnswer = true;
        _saveMessage = null;
        _saveErrorMessage = null;

        try
        {
            var savedAnswer = await ReflectionAnswerService.SaveAnswerAsync(
            new SaveReflectionAnswerRequest
                {
                    JourneySlug = JourneySlug,
                    MilestoneSlug = MilestoneSlug,
                    DimensionSlug = DimensionSlug,

                    ReflectionPromptId = currentPrompt.Id,
                    ReflectionPromptSlug = currentPrompt.Slug,
                    ReflectionPromptTitle = currentPrompt.Title,

                    SelectedAnswerLabel = selectedAnswer.Label,
                    SelectedAnswerDescription = selectedAnswer.Description,
                    SelectedStatus = selectedAnswer.Status,
                    SelectedConcernLevel = selectedAnswer.ConcernLevel,
                    GuidanceMessage = selectedAnswer.GuidanceMessage,

                    Notes = _notes
                });

            _savedAnswersByPromptId[currentPrompt.Id] = savedAnswer;

            if (!selectedAnswer.EndsPath)
            {
                _promptHistory.Add(new PromptHistoryEntry
                {
                    PromptIndex = _currentPromptIndex,
                    VisibleQuestionNumber = _visibleQuestionNumber
                });
            }

            await SaveProgressAfterAnswerAsync(currentPrompt, selectedAnswer);

            await MoveAfterSavedAnswerAsync(currentPrompt, selectedAnswer);
        }
        catch (Exception ex)
        {
            _saveErrorMessage = ex.Message;
        }
        finally
        {
            _isSavingAnswer = false;
        }
    }

    // This stores the next prompt to resume later.
    private async Task SaveProgressAfterAnswerAsync(
        ReflectionPromptView currentPrompt,
        AnswerOptionView selectedAnswer)
    {
        if (selectedAnswer.EndsPath)
        {
            var status = string.IsNullOrWhiteSpace(selectedAnswer.ProgressStatus)
                ? "completed"
                : selectedAnswer.ProgressStatus;

            _dimensionProgress = await DimensionProgressService.SaveProgressAsync(
                new SaveDimensionProgressRequest
                {
                    JourneySlug = JourneySlug,
                    MilestoneSlug = MilestoneSlug,
                    DimensionSlug = DimensionSlug,
                    Status = status,
                    CurrentPromptId = currentPrompt.Id,
                    CurrentPromptSlug = currentPrompt.Slug,
                    VisibleQuestionNumber = _visibleQuestionNumber,
                    PromptHistoryJson = SerializePromptHistory(),
                    OutcomeKey = selectedAnswer.OutcomeKey,
                    OutcomeMessage = selectedAnswer.OutcomeMessage,
                    RecommendedMilestoneSlug = selectedAnswer.RecommendedMilestoneSlug,
                    RecommendedMilestoneTitle = selectedAnswer.RecommendedMilestoneTitle,
                    CompletedAt = DateTime.UtcNow
                });

            return;
        }

        var nextPromptId = selectedAnswer.NextPromptId;
        var nextPromptSlug = selectedAnswer.NextPromptSlug;

        if (string.IsNullOrWhiteSpace(nextPromptId))
        {
            var nextIndex = _prompts.FindIndex(prompt =>
                string.Equals(prompt.Id, currentPrompt.Id, StringComparison.OrdinalIgnoreCase)) + 1;

            var nextPrompt = nextIndex >= 0 && nextIndex < _prompts.Count
                ? _prompts[nextIndex]
                : null;

            nextPromptId = nextPrompt?.Id;
            nextPromptSlug = nextPrompt?.Slug;
        }

        _dimensionProgress = await DimensionProgressService.SaveProgressAsync(
            new SaveDimensionProgressRequest
            {
                JourneySlug = JourneySlug,
                MilestoneSlug = MilestoneSlug,
                DimensionSlug = DimensionSlug,
                Status = "in_progress",
                CurrentPromptId = nextPromptId,
                CurrentPromptSlug = nextPromptSlug,
                VisibleQuestionNumber = _visibleQuestionNumber + 1,
                PromptHistoryJson = SerializePromptHistory(),
                CompletedAt = null
            });
    }

    // Moves to the next prompt in the reflection path after saving an answer, handling any branching logic based on the selected answer.
    private async Task MoveAfterSavedAnswerAsync(
        ReflectionPromptView answeredPrompt,
        AnswerOptionView selectedAnswer)
    {
        _selectedAnswer = null;
        _notes = string.Empty;
        _saveMessage = null;
        _saveErrorMessage = null;

        if (selectedAnswer.EndsPath)
        {
            EndPathFromAnswer(selectedAnswer);
            return;
        }

        var nextVisibleQuestionNumber = _visibleQuestionNumber + 1;

        var targetedPromptIndex = FindTargetPromptIndex(selectedAnswer);

        if (targetedPromptIndex >= 0)
        {
            ClearPathOutcome();
            
            _currentPromptIndex = targetedPromptIndex;
            _visibleQuestionNumber = nextVisibleQuestionNumber;
            _isComplete = false;

            LoadSavedAnswerForCurrentPrompt();
            return;
        }

        _visibleQuestionNumber = nextVisibleQuestionNumber;

        await MoveToNextUnansweredPromptAfterAsync(answeredPrompt);
    }

    // Moves to the next unanswered prompt in the reflection path, if any, or marks the reflection as complete if all prompts have been answered.
    private async Task MoveToNextUnansweredPromptAfterAsync(ReflectionPromptView answeredPrompt)
    {
        ClearPathOutcome();
        
        _selectedAnswer = null;
        _notes = string.Empty;
        _saveMessage = null;
        _saveErrorMessage = null;

        var answeredPromptIndex = _prompts.FindIndex(prompt =>
            string.Equals(prompt.Id, answeredPrompt.Id, StringComparison.Ordinal));

        for (var i = answeredPromptIndex + 1; i < _prompts.Count; i++)
        {
            if (!_savedAnswersByPromptId.ContainsKey(_prompts[i].Id))
            {
                _currentPromptIndex = i;
                _isComplete = false;
                
                LoadSavedAnswerForCurrentPrompt();
                return;
            }
        }

        await MarkDimensionCompletedAsync(answeredPrompt);
        
        _isComplete = true;
    }

    private AnswerOptionView? FindAnswerOptionForSavedAnswer(
        ReflectionPromptView prompt,
        ReflectionAnswerRecord savedAnswer)
    {
        return prompt.AnswerOptions.FirstOrDefault(answer =>
            string.Equals(
                answer.Label,
                savedAnswer.SelectedAnswerLabel,
                StringComparison.OrdinalIgnoreCase));
    }

    private int FindTargetPromptIndex(AnswerOptionView? answer)
    {
        if (answer is null)
        {
            return -1;
        }

        if (!string.IsNullOrWhiteSpace(answer.NextPromptId))
        {
            var indexById = _prompts.FindIndex(prompt =>
                string.Equals(prompt.Id, answer.NextPromptId, StringComparison.Ordinal));

            if (indexById >= 0)
            {
                return indexById;
            }
        }

        if (!string.IsNullOrWhiteSpace(answer.NextPromptSlug))
        {
            return _prompts.FindIndex(prompt =>
                string.Equals(prompt.Slug, answer.NextPromptSlug, StringComparison.OrdinalIgnoreCase));
        }

        return -1;
    }

    // Navigates to the previous prompt in the reflection path.
    private async Task PreviousPromptAsync()
    {
        if (_promptHistory.Count == 0)
        {
            return;
        }

        var previousEntry = _promptHistory[^1];
        _promptHistory.RemoveAt(_promptHistory.Count - 1);

        _currentPromptIndex = previousEntry.PromptIndex;
        _visibleQuestionNumber = previousEntry.VisibleQuestionNumber;

        _saveMessage = null;
        _saveErrorMessage = null;
        _isComplete = false;

        ClearPathOutcome();

        LoadSavedAnswerForCurrentPrompt();

        var currentPrompt = CurrentPrompt;

        if (currentPrompt is not null)
        {
            _dimensionProgress = await DimensionProgressService.SaveProgressAsync(
                new SaveDimensionProgressRequest
                {
                    JourneySlug = JourneySlug,
                    MilestoneSlug = MilestoneSlug,
                    DimensionSlug = DimensionSlug,
                    Status = "in_progress",
                    CurrentPromptId = currentPrompt.Id,
                    CurrentPromptSlug = currentPrompt.Slug,
                    VisibleQuestionNumber = _visibleQuestionNumber,
                    PromptHistoryJson = SerializePromptHistory(),
                    CompletedAt = null
                });
        }
    }

    // Clears the path outcome state, allowing the user to restart the reflection path.
    private void ClearPathOutcome()
    {
        _pathEnded = false;
        _outcomeMessage = null;
        _outcomeKey = null;
        _progressStatus = null;
        _recommendedMilestoneSlug = null;
        _recommendedMilestoneTitle = null;
    }
    
    // Ends the reflection path based on the provided answer option, setting the appropriate outcome state.
    private void EndPathFromAnswer(AnswerOptionView answer)
    {
        _pathEnded = true;
        _isComplete = false;

        _outcomeMessage = answer.OutcomeMessage;
        _outcomeKey = answer.OutcomeKey;
        _progressStatus = answer.ProgressStatus;
        _recommendedMilestoneSlug = answer.RecommendedMilestoneSlug;
        _recommendedMilestoneTitle = answer.RecommendedMilestoneTitle;

        _saveMessage = null;
        _saveErrorMessage = null;
    }

    // Attempts to move to a specific prompt in the reflection path based on the provided prompt ID.
    private bool TryMoveToPrompt(string promptId)
    {
        if (string.IsNullOrWhiteSpace(promptId))
        {
            return false;
        }

        var nextIndex = _prompts.FindIndex(prompt =>
            string.Equals(prompt.Id, promptId, StringComparison.OrdinalIgnoreCase));

        if (nextIndex < 0)
        {
            _saveErrorMessage = "The next reflection prompt could not be found.";
            return false;
        }

        ClearPathOutcome();

        _currentPromptIndex = nextIndex;
        _selectedAnswer = null;
        _notes = string.Empty;
        _saveMessage = null;
        _saveErrorMessage = null;
        _isComplete = false;

        LoadSavedAnswerForCurrentPrompt();

        return true;
    }

    private async Task RestartCurrentDimensionAsync()
    {
        if (_view is null)
        {
            return;
        }

        _isSavingAnswer = true;
        _saveErrorMessage = null;
        _saveMessage = null;

        try
        {
            await ReflectionAnswerService.DeleteAnswersForDimensionAsync(
                JourneySlug,
                MilestoneSlug,
                DimensionSlug);

            await DimensionProgressService.DeleteProgressForDimensionAsync(
                JourneySlug,
                MilestoneSlug,
                DimensionSlug);

            _savedAnswersByPromptId.Clear();
            _dimensionProgress = null;

            MoveToBeginningOfReflection();
        }
        catch (Exception ex)
        {
            _saveErrorMessage = ex.Message;
        }
        finally
        {
            _isSavingAnswer = false;
        }
    }

    private void MoveToBeginningOfReflection()
    {
        ClearPathOutcome();

        _promptHistory.Clear();
        _visibleQuestionNumber = 1;

        _selectedAnswer = null;
        _notes = string.Empty;
        _saveMessage = null;
        _saveErrorMessage = null;
        _isComplete = false;

        if (_prompts.Count == 0)
        {
            _currentPromptIndex = 0;
            _isComplete = true;
            return;
        }

        _currentPromptIndex = 0;

        LoadSavedAnswerForCurrentPrompt();
    }

    private string SerializePromptHistory()
    {
        return JsonSerializer.Serialize(_promptHistory);
    }

    private void RestorePromptHistory(string? promptHistoryJson)
    {
        _promptHistory.Clear();

        if (string.IsNullOrWhiteSpace(promptHistoryJson))
        {
            return;
        }

        try
        {
            var restoredHistory = JsonSerializer.Deserialize<List<PromptHistoryEntry>>(
                promptHistoryJson);

            if (restoredHistory is not null)
            {
                _promptHistory = restoredHistory;
            }
        }
        catch
        {
            _promptHistory.Clear();
        }
    }

    // This tells Supabase that this dimension is completed, even though it did not end through an EndsPath answer.
    private async Task MarkDimensionCompletedAsync(ReflectionPromptView finalPrompt)
    {
        _dimensionProgress = await DimensionProgressService.SaveProgressAsync(
            new SaveDimensionProgressRequest
            {
                JourneySlug = JourneySlug,
                MilestoneSlug = MilestoneSlug,
                DimensionSlug = DimensionSlug,
                Status = "completed",
                CurrentPromptId = finalPrompt.Id,
                CurrentPromptSlug = finalPrompt.Slug,
                VisibleQuestionNumber = _visibleQuestionNumber,
                PromptHistoryJson = SerializePromptHistory(),
                CompletedAt = DateTime.UtcNow
            });
    }
}
