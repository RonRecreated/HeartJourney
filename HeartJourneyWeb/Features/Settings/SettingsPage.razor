@page "/settings"

@using HeartJourneyWeb.Components.Auth
@using HeartJourneyWeb.Services.MilestoneReset
@using HeartJourneyWeb.Services.Profiles
@using HeartJourneyWeb.Services.MilestoneProgress
@using HeartJourneyWeb.Services.Account
@using HeartJourneyWeb.Services.Auth
@inject IAccountService AccountService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IMilestoneProgressService MilestoneProgressService
@inject IProfileService ProfileService
@inject IMilestoneResetService MilestoneResetService
@inject NavigationManager NavigationManager

<PageTitle>Settings</PageTitle>

<RequireAuth>
    <div class="settings-page">

        <header class="settings-header">
            <h1>Settings</h1>
            <p>Manage your Journey Recreated experience.</p>
        </header>

        <section class="settings-section">
            <h2>Profile & Onboarding</h2>

            <div class="settings-card profile-settings-card">

                <EditForm Model="_profileForm"
                        OnValidSubmit="SaveProfileSettingsAsync">

                    <DataAnnotationsValidator />

                    <div class="profile-form">

                        <div class="form-field">
                            <label for="ageBracket">Age bracket</label>

                            <InputSelect id="ageBracket"
                                        @bind-Value="_profileForm.AgeBracket">
                                <option value="">Choose one</option>
                                <option value="under18">Under 18</option>
                                <option value="18-24">18–24</option>
                                <option value="25-34">25–34</option>
                                <option value="35-44">35–44</option>
                                <option value="45-54">45–54</option>
                                <option value="55plus">55+</option>
                            </InputSelect>

                            <ValidationMessage For="@(() => _profileForm.AgeBracket)" />
                        </div>

                        <div class="form-field">
                            <label for="gender">Gender</label>

                            <InputSelect id="gender"
                                        @bind-Value="_profileForm.Gender">
                                <option value="">Choose one</option>
                                <option value="female">Female</option>
                                <option value="male">Male</option>
                            </InputSelect>

                            <ValidationMessage For="@(() => _profileForm.Gender)" />
                        </div>

                        <div class="form-field">
                            <label for="religiousBackground">
                                Religious background
                            </label>

                            <InputSelect id="religiousBackground"
                                        @bind-Value="_profileForm.ReligiousBackground">
                                <option value="">Choose one</option>
                                <option value="christian">Christian</option>
                                <option value="exploringChristianity">Exploring Christianity</option>
                                <option value="otherFaith">Other faith background</option>
                                <option value="none">No religious background</option>
                            </InputSelect>

                            <ValidationMessage For="@(() => _profileForm.ReligiousBackground)" />
                        </div>

                        <div class="form-field">
                            <label for="relationshipSeason">
                                Current relationship season
                            </label>

                            <InputSelect id="relationshipSeason"
                                        @bind-Value="_profileForm.CurrentRelationshipSeason">
                                <option value="">Choose one</option>
                                <option value="single">Single</option>
                                <option value="talking">Talking</option>
                                <option value="courting">Courting</option>
                                <option value="engaged">Engaged</option>
                                <option value="married">Married</option>
                                <option value="divorced">Divorced</option>
                            </InputSelect>

                            <ValidationMessage For="@(() => _profileForm.CurrentRelationshipSeason)" />
                        </div>

                        <button type="submit"
                                class="primary-button"
                                disabled="@_isSavingProfile">
                            @(_isSavingProfile
                                ? "Saving..."
                                : "Save Profile Settings")
                        </button>

                        @if (!string.IsNullOrWhiteSpace(_profileMessage))
                        {
                            <p class="profile-message">
                                @_profileMessage
                            </p>
                        }

                    </div>

                </EditForm>

            </div>
        </section>

        <section class="settings-section">
            <h2>Journey Data</h2>

            @if (_isLoading)
            {
                <p>Loading settings...</p>
            }
            else if (_startedMilestones.Count == 0)
            {
                <p>You haven't started any milestones yet.</p>
            }
            else
            {
                @foreach (var milestone in _startedMilestones)
                {
                    <div class="settings-card">
                        <div class="settings-card-content">
                            <h3>@FormatMilestoneName(milestone.MilestoneSlug)</h3>

                            <p>
                                Clear your reflections, progress, insights,
                                growth steps, and introduction progress for this milestone.
                            </p>
                        </div>

                        <button type="button"
                                class="danger-button"
                                @onclick="() => OpenResetConfirmation(milestone)">
                            Reset Milestone
                        </button>
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_resetError))
            {
                <p class="settings-error">@_resetError</p>
            }
        </section>

        <section class="settings-section">
            <h2>Support</h2>

            <div class="support-card">
                <h3>Need help?</h3>

                <p>
                    If you have a question or need assistance with Journey Recreated,
                    feel free to contact support by email.
                </p>

                <a class="support-email-link" href="mailto:support@journeyrecreated.com">
                    Email Support
                </a>
            </div>
        </section>

        <section class="settings-section">
            <div class="settings-section-header">
                <div>
                    <h2>Frequently Asked Questions</h2>
                    <p>Quick answers about using Journey Recreated.</p>
                </div>
            </div>

            <div class="faq-list">

                <details class="faq-item">
                    <summary>How do I install Journey Recreated on Android?</summary>

                    <div class="faq-answer">
                        <p>Open Journey Recreated in Google Chrome.</p>

                        <ol>
                            <li>Tap the three-dot menu in the upper-right corner.</li>
                            <li>Choose <strong>Install and create shortcut</strong> or <strong>Add to Home screen</strong>.</li>
                            <li>Click Install. And follow the prompts to install Journey Recreated.</li>
                        </ol>

                        <p>
                            Once installed, Journey Recreated can be opened from
                            your home screen like a regular app.
                        </p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>
                        How do I install Journey Recreated on an iPhone or iPad?
                    </summary>

                    <div class="faq-answer">
                        <p>Open Journey Recreated in <strong>Safari</strong>.</p>

                        <ol>
                            <li>Tap the three-dot menu in the lower-right corner.</li>
                            <li>Tap the <strong>Share</strong> button.</li>
                            <li>Tap <strong>View More</strong></li>
                            <li>Select <strong>Add to Home Screen</strong>.</li>
                            <li>Make sure <strong>Open as Web App</strong> is enabled if the option appears.</li>
                            <li>Tap <strong>Add</strong>.</li>
                        </ol>

                        <p>Journey Recreated will then appear on your home screen.</p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>How do I install Journey Recreated on my computer?</summary>

                    <div class="faq-answer">
                        <p>If you use Microsoft Edge or Google Chrome, open Journey Recreated in the browser.</p>

                        <p>Look for an install icon in the address bar. It might look like 3 blocks with a plus sign.
                            Or. open the browser menu and look for an option such as <strong>Install Journey Recreated</strong> 
                            or <strong>Install app</strong>.</p>

                        <p>Once installed, Journey Recreated can open in its own window and can be launched 
                            from your computer like other applications.</p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>Do I have to install Journey Recreated?</summary>

                    <div class="faq-answer">
                        <p>No. Journey Recreated works directly from your web browser.</p>

                        <p>Installing it simply gives you quicker access and a more app-like experience.</p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>
                        Will my Journey progress be saved if I use another device?
                    </summary>

                    <div class="faq-answer">
                        <p>
                            Yes. When you sign in to the same Journey Recreated
                            account, your saved progress, reflection responses,
                            and action steps remain associated with your account.
                        </p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>
                        What happens if I forget my password?
                    </summary>

                    <div class="faq-answer">
                        <p>
                            Use the <strong>Forgot Password</strong> option on the
                            sign-in page. A password-reset message will be sent
                            to the email address associated with your account.
                        </p>
                    </div>
                </details>


                <details class="faq-item">
                    <summary>
                        How do I request a refund?
                    </summary>

                    <div class="faq-answer">
                        <p>
                            Please review our <a href="/refund-policy">Refund Policy</a>
                            for eligibility and instructions.
                        </p>

                        <p>
                            Refund requests can be sent to 
                            <a href="mailto:support@journeyrecreated.com">support@journeyrecreated.com</a>.
                        </p>
                    </div>
                </details>

            </div>
        </section>

        <section class="settings-section">
            <div class="settings-section-header">
                <div>
                    <h2>Legal & Policies</h2>
                    <p>Review Journey Recreated's policies and terms.</p>
                </div>
            </div>

            <div class="policy-links">
                <a href="/refund-policy" class="policy-link">
                    <div class="policy-link-content">
                        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>

                        <span>Refund Policy</span>
                    </div>

                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>

                <a href="/privacy-policy" class="policy-link">
                    <div class="policy-link-content">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>

                        <span>Privacy Policy</span>
                    </div>

                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>

                <a href="/terms" class="policy-link">
                    <div class="policy-link-content">
                        <i class="fa-solid fa-file-contract" aria-hidden="true"></i>

                        <span>Terms & Conditions</span>
                    </div>

                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>

        <section class="settings-section danger-zone">
            <h2>Delete Account</h2>

            <div class="danger-card">

                <h3>Permanently delete your account</h3>

                <p>
                    This will permanently delete your Journey Recreated
                    account and all of your saved journey information,
                    including reflections, progress, insights, and profile
                    information.
                </p>

                <p>
                    This action cannot be undone.
                </p>

                <button type="button"
                        class="danger-button"
                        @onclick="OpenDeleteAccountModal">
                    Delete My Account
                </button>

            </div>
        </section>

    </div>

    @if (_showDeleteAccountModal)
    {
        <div class="modal-backdrop"
            @onclick="CloseDeleteAccountModal">

            <div class="confirmation-modal delete-account-modal"
                role="dialog"
                aria-modal="true"
                @onclick:stopPropagation="true">

                <p class="danger-eyebrow">
                    Permanent Action
                </p>

                <h2>Delete your account?</h2>

                <p>
                    Your profile, reflection answers, journey progress,
                    dimension progress, growth steps, and account will
                    be permanently deleted.
                </p>

                <p>
                    You will not be able to recover this information.
                </p>

                @if (!string.IsNullOrWhiteSpace(_deleteAccountError))
                {
                    <div class="message error">
                        @_deleteAccountError
                    </div>
                }

                <div class="confirmation-actions">

                    <button type="button"
                            class="secondary-button"
                            disabled="@_isDeletingAccount"
                            @onclick="CloseDeleteAccountModal">
                        Cancel
                    </button>

                    <button type="button"
                            class="danger-button"
                            disabled="@_isDeletingAccount"
                            @onclick="DeleteAccountAsync">

                        @(_isDeletingAccount
                            ? "Deleting..."
                            : "Permanently Delete Account")

                    </button>

                </div>

            </div>
        </div>
    }

    @if (_showResetConfirmation)
    {
        <div class="modal-backdrop"
            @onclick="CloseResetConfirmation">

            <div class="confirmation-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="resetMilestoneTitle"
                @onclick:stopPropagation="true">

                <h2 id="resetMilestoneTitle">
                    Reset @FormatMilestoneName(_milestoneToReset?.MilestoneSlug ?? "") Milestone?
                </h2>

                <p>
                    This will permanently clear your reflections,
                    progress, insights, and growth-step progress
                    for this milestone.
                </p>

                <p class="confirmation-note">
                    Your profile and current relationship season will not change.
                </p>

                @if (!string.IsNullOrWhiteSpace(_resetError))
                {
                    <p class="settings-error">
                        @_resetError
                    </p>
                }

                <div class="confirmation-actions">
                    <button type="button"
                            class="secondary-button"
                            disabled="@_isResetting"
                            @onclick="CloseResetConfirmation">
                        Cancel
                    </button>

                    <button type="button"
                            class="danger-button"
                            disabled="@_isResetting"
                            @onclick="ResetSelectedMilestoneAsync">
                        @(_isResetting
                            ? "Resetting..."
                            : "Reset Milestone")
                    </button>
                </div>

            </div>
        </div>
    }
</RequireAuth>

@code{
    private HeartJourneyProfile? _profile;
    private HeartJourneyProfile _profileForm = new();
    private bool _isSavingProfile;
    private string? _profileMessage;
    private bool _isResetting;
    private string? _resetError;
    private const string RelationshipJourneySlug = "relationship";

    private string? _currentMilestoneSlug;

    private bool _isLoading = true;
    private bool _showResetConfirmation;

    private bool _showDeleteAccountModal;
    private bool _isDeletingAccount;
    private string? _deleteAccountError;
    private string CurrentMilestoneDisplayName =>
        string.IsNullOrWhiteSpace(_currentMilestoneSlug)
            ? "Current"
            : char.ToUpperInvariant(_currentMilestoneSlug[0]) +
                _currentMilestoneSlug[1..];
    private IReadOnlyList<MilestoneProgressRecord> _startedMilestones =
        Array.Empty<MilestoneProgressRecord>();

    private MilestoneProgressRecord? _milestoneToReset;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await ProfileService.EnsureProfileAsync();
            
            _profileForm = new HeartJourneyProfile
            {
                AgeBracket = _profile.AgeBracket,
                Gender = _profile.Gender,
                ReligiousBackground = _profile.ReligiousBackground,
                CurrentRelationshipSeason = _profile.CurrentRelationshipSeason
            };

            _currentMilestoneSlug =
                _profile.CurrentRelationshipSeason;

            _startedMilestones =
                await MilestoneProgressService.GetProgressForJourneyAsync(
                    RelationshipJourneySlug);
        }
        catch (Exception ex)
        {
            _resetError =
                $"Unable to load settings. {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetSelectedMilestoneAsync()
    {
        if (_isResetting || _milestoneToReset is null)
        {
            return;
        }

        _isResetting = true;
        _resetError = null;

        try
        {
            await MilestoneResetService.ResetMilestoneAsync(
                RelationshipJourneySlug,
                _milestoneToReset.MilestoneSlug);
            
            _startedMilestones =
                await MilestoneProgressService.GetProgressForJourneyAsync(
                    RelationshipJourneySlug);

            _milestoneToReset = null;
            _showResetConfirmation = false;

            NavigationManager.NavigateTo(
                $"/journeys/{RelationshipJourneySlug}");
        }
        catch (Exception ex)
        {
            _resetError = ex.Message;
        }
        finally
        {
            _isResetting = false;
        }
    }

    private void OpenResetConfirmation()
    {
        if (string.IsNullOrWhiteSpace(_currentMilestoneSlug))
        {
            return;
        }

        _showResetConfirmation = true;
    }

    private void CloseResetConfirmation()
    {
        if (_isResetting)
        {
            return;
        }

        _showResetConfirmation = false;
    }

    private void OpenResetConfirmation(
        MilestoneProgressRecord milestone)
    {
        _milestoneToReset = milestone;
        _showResetConfirmation = true;
    }

    private static string FormatMilestoneName(string slug)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return "Milestone";
        }

        return char.ToUpperInvariant(slug[0]) + slug[1..];
    }

    private async Task SaveProfileSettingsAsync()
    {
        if (_isSavingProfile || _profile is null)
        {
            return;
        }

        _isSavingProfile = true;
        _profileMessage = null;

        try
        {
            // Only copy the fields that Settings is allowed to change.
            _profile.AgeBracket =
                _profileForm.AgeBracket;

            _profile.Gender =
                _profileForm.Gender;

            _profile.ReligiousBackground =
                _profileForm.ReligiousBackground;

            _profile.CurrentRelationshipSeason =
                _profileForm.CurrentRelationshipSeason;

            var updatedProfile =
                await ProfileService.UpdateProfileAsync(
                    _profile);

            _profile = updatedProfile;

            _currentMilestoneSlug =
                updatedProfile.CurrentRelationshipSeason;

            _profileMessage =
                "Your profile settings have been updated.";
        }
        catch (Exception ex)
        {
            _profileMessage =
                $"Unable to save your profile settings. {ex.Message}";
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private void OpenDeleteAccountModal()
    {
        _deleteAccountError = null;
        _showDeleteAccountModal = true;
    }

    private void CloseDeleteAccountModal()
    {
        if (_isDeletingAccount)
        {
            return;
        }

        _showDeleteAccountModal = false;
    }

    private async Task DeleteAccountAsync()
    {
        if (_isDeletingAccount)
        {
            return;
        }

        _isDeletingAccount = true;
        _deleteAccountError = null;

        try
        {
            await AccountService.DeleteAccountAsync();

            // The Auth user has already been permanently deleted.
            // Only clear Journey Recreated's locally stored session.
            await AuthService.ClearLocalSessionAsync();

            Navigation.NavigateTo(
                "/journeys",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            _deleteAccountError =
                $"Unable to delete your account. {ex.Message}";
        }
        finally
        {
            _isDeletingAccount = false;
        }
    }
}