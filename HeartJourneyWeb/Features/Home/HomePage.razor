@page "/journeys"
@using HeartJourney.Core.Features.Home
@using HeartJourney.Core.Services.Interfaces
@using HeartJourneyWeb.Helpers
@using HeartJourneyWeb.Components
@using HeartJourneyWeb.Services.JourneyAccess
@using HeartJourneyWeb.Services.Auth
@inject IAuthService AuthService
@inject IContentRepository ContentRepository
@inject IJourneyAccessService JourneyAccessService

<PageTitle>Journey Recreated</PageTitle>

<section class="home-shell">
    <div class="hero">
        <p class="eyebrow">Journey Recreated</p>
        <h1>Helping you grow and have a Christ-centered journey.</h1>
        <p class="hero-text">
            Choose a journey that you would like to begin recreating.
        </p>
    </div>

    @if (_isLoading)
    {
        <JourneyLoader Message="Loading journeys..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-card">
            <strong>Something went wrong.</strong>
            <p>@_errorMessage</p>
        </div>
    }
    else if (_journeys.Count == 0)
    {
        <p>No published journeys were found.</p>
    }
    else
    {
        <div class="journey-grid">
            @foreach (var journey in _journeys)
            {
                <article class="journey-card @(journey.IsAvailable ? null : "coming-soon-card")">
                    <div class="journey-icon">
                        <i class="@IconHelper.GetIconClass(journey.Icon)" aria-hidden="true"></i>
                    </div>

                    <h2>@journey.Title</h2>

                    <p>@journey.Summary</p>

                    @if (journey.IsAvailable)
                    {
                        if (HasJourneyAccess(journey.Slug))
                        {
                            <a href="@($"/journeys/{journey.Slug}")" class="journey-action">
                                Continue Journey
                            </a>
                        }
                        else
                        {
                            @* PAYWALL PREVIEW: exploration starts here; checkout lives on intro card four. *@
                            <a href="@($"/journeys/{journey.Slug}")" class="journey-action">
                                Explore Journey
                            </a>
                        }
                    }
                    else
                    {
                        <div class="coming-soon-action">
                            <span class="coming-soon-badge">
                                <i class="fa-solid fa-clock"></i> <!-- Optional clock icon -->

                                @(string.IsNullOrWhiteSpace(journey.ComingSoonText)
                                    ? "Coming Soon"
                                    : journey.ComingSoonText)
                            </span>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private List<JourneyCard> _journeys = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private HashSet<string> _ownedJourneySlugs =
        new(StringComparer.OrdinalIgnoreCase);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            // PAYWALL PREVIEW: restore ownership before choosing Explore versus Continue.
            await AuthService.InitializeAsync();
            var journeys = await ContentRepository.GetJourneyCardsAsync();
            
            _journeys = journeys.ToList();

            var accessRecords =
                await JourneyAccessService
                    .GetUserAccessAsync();

            _ownedJourneySlugs =
                accessRecords
                    .Where(x => !string.IsNullOrWhiteSpace(x.JourneySlug))
                    .Select(x => x.JourneySlug!)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool HasJourneyAccess(string? journeySlug)
    {
        return !string.IsNullOrWhiteSpace(journeySlug) && _ownedJourneySlugs.Contains(journeySlug);
    }

}
