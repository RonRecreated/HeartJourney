@page "/auth/confirmed"
@inject NavigationManager NavigationManager

<PageTitle>Email Confirmed - Journey Recreated</PageTitle>

<section class="auth-confirmed-shell">
    <div class="confirmed-card">
        <p class="eyebrow">Journey Recreated</p>

        <h1>Your email has been confirmed</h1>

        <p class="intro">
            Thank you for confirming your account. You can now sign in and proceed to recreate your journey.
        </p>

        <button type="button"
                class="primary-button"
                @onclick="GoToSignIn">
            Sign In
        </button>
    </div>
</section>

@code {
    // PAYWALL PREVIEW: the confirmation email can carry the local milestone destination.
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void GoToSignIn()
    {
        var destination = HeartJourneyWeb.Helpers.JourneyPreviewNavigation.SafeReturnUrl(ReturnUrl);
        NavigationManager.NavigateTo($"/auth?returnUrl={Uri.EscapeDataString(destination)}");
    }
}
