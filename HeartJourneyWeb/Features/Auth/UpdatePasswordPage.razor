@page "/update-password"
@using HeartJourneyWeb.Services.Auth
@using System.ComponentModel.DataAnnotations

@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Update Password</PageTitle>

<div class="password-reset-shell">

    <section class="password-reset-card">

        @if (_passwordUpdated)
        {
            <div class="success-state">

                <p class="eyebrow">
                    Password Updated
                </p>

                <h1>Your password has been changed.</h1>

                <p class="intro">
                    You can now continue using Journey Recreated
                    with your new password.
                </p>

                <button type="button"
                        class="primary-button"
                        @onclick="GoToSignIn">
                    Continue to Sign In
                </button>

            </div>
        }
        else if (_isCheckingRecovery)
        {
            <div class="password-reset-shell">
                <section class="password-reset-card">
                    <p>Verifying your password reset link...</p>
                </section>
            </div>
        }
        else if (!_recoverySessionReady)
        {
            <p class="eyebrow">
                Account Recovery
            </p>

            <h1>This reset link is no longer valid.</h1>

            <p class="intro">
                The password reset link may have expired or already been used.
                Please request a new password reset email.
            </p>

            <button type="button"
                    class="primary-button"
                    @onclick="GoToSignIn">
                Return to Sign In
            </button>
        }
        else
        {
            <p class="eyebrow">
                Account Recovery
            </p>

            <h1>Create a new password</h1>

            <p class="intro">
                Choose a new password for your Journey Recreated account.
            </p>

            <EditForm Model="_form"
                      OnValidSubmit="UpdatePasswordAsync">

                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="newPassword">
                        New password
                    </label>

                    <InputText id="newPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="_form.Password" />

                    <ValidationMessage For="@(() => _form.Password)" />
                </div>

                <div class="form-field">
                    <label for="confirmPassword">
                        Confirm new password
                    </label>

                    <InputText id="confirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="_form.ConfirmPassword" />

                    <ValidationMessage For="@(() => _form.ConfirmPassword)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="message error">
                        @_message
                    </div>
                }

                <button type="submit"
                        class="primary-button"
                        disabled="@_isSaving">
                    @(_isSaving ? "Updating..." : "Update Password")
                </button>

            </EditForm>
        }

    </section>

</div>

@code {

    private readonly PasswordUpdateForm _form = new();

    private bool _isSaving;
    private bool _passwordUpdated;
    private string? _message;
    private bool _isCheckingRecovery = true;
    private bool _recoverySessionReady;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUrl = Navigation.Uri;

            _recoverySessionReady =
                await AuthService.EstablishRecoverySessionAsync(
                    currentUrl);
        }
        catch
        {
            _recoverySessionReady = false;
        }
        finally
        {
            _isCheckingRecovery = false;
        }
    }

    private async Task UpdatePasswordAsync()
    {
        if (_isSaving)
        {
            return;
        }

        if (_form.Password != _form.ConfirmPassword)
        {
            _message = "The passwords do not match.";
            return;
        }

        _isSaving = true;
        _message = null;

        try
        {
            var success =
                await AuthService.UpdatePasswordAsync(
                    _form.Password);

            if (!success)
            {
                _message =
                    "Unable to update your password. Your recovery link may have expired.";
                return;
            }

            _passwordUpdated = true;

            await AuthService.SignOutAsync();
        }
        catch
        {
            _message =
                "Unable to update your password. Your recovery link may have expired. Please request a new password reset email.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void GoToSignIn()
    {
        Navigation.NavigateTo("/auth");
    }

    private sealed class PasswordUpdateForm
    {
        [Required]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}