@page "/auth"
@using HeartJourneyWeb.Services.Auth
@using HeartJourneyWeb.Services.Profiles
@inject IProfileService ProfileService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Sign In - Journey Recreated</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">Journey Recreated</p>

        <h1>@(_isCreateAccountMode ? "Create your account" : "Welcome back")</h1>

        <p class="intro">
            Sign in to save your journey, reflection answers, notes, and future insights.
        </p>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_isError ? "message error" : "message success")">
                @_message
            </div>
        }

        <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="email">Email</label>
                <InputText id="email"
                           type="email"
                           @bind-Value="_form.Email" />
                <ValidationMessage For="@(() => _form.Email)" />
            </div>

            <div class="form-field">
                <label for="password">Password</label>
                <InputText id="password"
                           type="password"
                           @bind-Value="_form.Password" />
                <ValidationMessage For="@(() => _form.Password)" />
            </div>

            @if (!_isCreateAccountMode)
            {
                <button type="button"
                        class="forgot-password-link"
                        @onclick="OpenForgotPassword">
                    Forgot password?
                </button>
            }

            <button type="submit" class="primary-button" disabled="@_isBusy">
                @if (_isBusy)
                {
                    <span>Please wait...</span>
                }
                else
                {
                    <span>@(_isCreateAccountMode ? "Create Account" : "Sign In")</span>
                }
            </button>
        </EditForm>

        @if (_showForgotPassword)
        {
            <div class="modal-backdrop"
                @onclick="() => _showForgotPassword = false">

                <div class="confirmation-modal"
                    role="dialog"
                    aria-modal="true"
                    @onclick:stopPropagation="true">

                    <h2>Reset your password</h2>

                    <p>
                        Enter your email address and we'll send you
                        a password reset link.
                    </p>

                    <input type="email"
                        class="form-control"
                        @bind="_resetEmail" />

                    @if (!string.IsNullOrWhiteSpace(_resetMessage))
                    {
                        <p>@_resetMessage</p>
                    }

                    <div class="confirmation-actions">
                        <button type="button"
                                class="secondary-button"
                                disabled="@_isSendingReset"
                                @onclick="() => _showForgotPassword = false">
                            Cancel
                        </button>

                        <button type="button"
                                class="primary-button"
                                disabled="@_isSendingReset"
                                @onclick="SendPasswordResetAsync">
                            @(_isSendingReset ? "Sending..." : "Send Reset Link")
                        </button>
                    </div>
                </div>
            </div>
        }

        <button type="button"
                class="mode-button"
                @onclick="ToggleMode"
                disabled="@_isBusy">
            @if (_isCreateAccountMode)
            {
                <span>Already have an account? Sign in</span>
            }
            else
            {
                <span>Need an account? Create one</span>
            }
        </button>
    </div>
</section>

@code {
    private readonly AuthFormModel _form = new();

    private bool _isCreateAccountMode;
    private bool _isBusy;
    private bool _isError;
    private string? _message;
    private bool _showForgotPassword;
    private string _resetEmail = string.Empty;
    private bool _isSendingReset;
    private string? _resetMessage;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.IsSignedIn)
        {
            NavigationManager.NavigateTo(
                string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
        }
    }

    private async Task HandleSubmitAsync()
    {
        _isBusy = true;
        _message = null;
        _isError = false;

        try
        {
            AuthResult result;

            if (_isCreateAccountMode)
            {
                result = await AuthService.SignUpAsync(
                    _form.Email,
                    _form.Password);
            }
            else
            {
                result = await AuthService.SignInAsync(
                    _form.Email,
                    _form.Password);
            }

            _message = result.Message;
            _isError = !result.Succeeded;
            _form.Password = string.Empty;

            if (result.Succeeded && AuthService.IsSignedIn)
            {
                var profile = await ProfileService.EnsureProfileAsync();

                Console.WriteLine(
                    $"Profile loaded: User={profile.Id}, " +
                    $"OnboardingCompleted={profile.OnboardingCompleted}, " +
                    $"DisplayName='{profile.DisplayName}', " +
                    $"Email='{profile.Email}'");

                if (!profile.OnboardingCompleted)
                {
                    NavigationManager.NavigateTo("/welcome");
                    return;
                }
                
                NavigationManager.NavigateTo(
                    string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleMode()
    {
        _isCreateAccountMode = !_isCreateAccountMode;
        _message = null;
        _isError = false;
    }

    private void OpenForgotPassword()
    {
        _resetEmail = _form.Email;
        _resetMessage = null;
        _showForgotPassword = true;
    }

    private async Task SendPasswordResetAsync()
    {
        if (_isSendingReset ||
            string.IsNullOrWhiteSpace(_resetEmail))
        {
            return;
        }

        _isSendingReset = true;
        _resetMessage = null;

        try
        {
            await AuthService.SendPasswordResetEmailAsync(_resetEmail);

            _resetMessage =
                "If an account exists for that email address, a reset link has been sent.";
        }
        catch
        {
            _resetMessage =
                "Unable to send the reset email right now. Please try again.";
        }
        finally
        {
            _isSendingReset = false;
        }
    }
}