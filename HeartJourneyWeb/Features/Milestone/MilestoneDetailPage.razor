@page "/journeys/{JourneySlug}/milestones/{MilestoneSlug}"
@using HeartJourney.Core.Features.Milestone
@using HeartJourney.Core.Services.Interfaces
@using HeartJourneyWeb.Services.Auth
@using Microsoft.JSInterop
@using HeartJourneyWeb.Services.ReflectionAnswers
@using HeartJourneyWeb.Services.DimensionProgress
@inject IDimensionProgressService DimensionProgressService
@inject IReflectionAnswerService ReflectionAnswerService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IContentRepository ContentRepository
@inject IJSRuntime JSRuntime

<PageTitle>@(_milestone?.Title ?? "Milestone")</PageTitle>

<section class="milestone-detail-shell">
    <!-- Loading, error, and content will be rendered here -->
    @if (_isLoading)
    {
        <p>Loading milestone...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-card">
            <strong>Something went wrong.</strong>
            <p>@_errorMessage</p>
        </div>
    }
    else if (_milestone is null)
    {
        <p>Milestone not found.</p>
    }
    else
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_milestone.JourneySlug}")">@_milestone.JourneyTitle</a>
            <span>/</span>
            <span>@_milestone.Title</span>
        </nav>

        <header class="milestone-hero">
            <p class="eyebrow">Current Milestone</p>
            <h1>@_milestone.Title</h1>

            @if (!string.IsNullOrWhiteSpace(_milestone.Motto))
            {
                <p class="motto">@_milestone.Motto</p>
            }

            @if (!string.IsNullOrWhiteSpace(_milestone.Summary))
            {
                <p class="summary">@_milestone.Summary</p>
            }

            @if (!string.IsNullOrWhiteSpace(_milestone.Purpose))
            {
                <p class="purpose">@_milestone.Purpose</p>
            }
        </header>

        <section class="guidance-grid">
            @if (_milestone.HealthyCharacteristics?.Count > 0)
            {
                <article class="guidance-card">
                    <h2>Healthy Characteristics</h2>

                    <ul>
                        @foreach (var item in _milestone.HealthyCharacteristics)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </article>
            }

            @if (_milestone.PotentialPitfalls?.Count > 0)
            {
                <article class="guidance-card">
                    <h2>Potential Pitfalls</h2>

                    <ul>
                        @foreach (var item in _milestone.PotentialPitfalls)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </article>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(_milestone.DesiredOutcome))
        {
            <section class="desired-outcome">
                <h2>Desired Outcome</h2>
                <p>@_milestone.DesiredOutcome</p>
            </section>
        }

        <!-- Show Reset Success/Error Messages -->
        @if (!string.IsNullOrWhiteSpace(_resetErrorMessage))
        {
            <div class="error-card">
                <p>@_resetErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_resetSuccessMessage))
        {
            <div class="success-card">
                <p>@_resetSuccessMessage</p>
            </div>
        }

        <!-- Dimension Section -->
        <section class="dimension-section">
            <h2>What area would you like to reflect on?</h2>
            <p class="section-text">
                Choose a growth area connected to this milestone.
            </p>

            @if (_milestone.Dimensions is null || _milestone.Dimensions.Count == 0)
            {
                <p>No published dimensions were found for this milestone.</p>
            }
            else
            {
                <div class="dimension-grid">
                    @foreach (var dimension in _milestone.Dimensions ?? [])
                    {
                        <!-- Dimension Card Markup -->
                        var statusLabel = GetDimensionStatusLabel(dimension.Slug);
                        var statusClass = GetDimensionStatusClass(dimension.Slug);
                        var hasStarted = IsDimensionStarted(dimension.Slug);

                        <article class="dimension-card @statusClass">
                            @if (!string.IsNullOrWhiteSpace(statusLabel))
                            {
                                <div class="status-badge @statusClass">@statusLabel</div>
                            }
                            
                            <h3>@dimension.Title</h3>

                            @if (!string.IsNullOrWhiteSpace(dimension.Summary))
                            {
                                <p>@dimension.Summary</p>
                            }

                            <div class="dimension-actions">
                                <a href="@($"/journeys/{JourneySlug}/milestones/{MilestoneSlug}/dimensions/{dimension.Slug}")">
                                    @GetDimensionActionText(dimension)
                                </a>

                                @if (hasStarted)
                                {
                                    <button type="button"
                                            class="restart-button"
                                            disabled="@(_resettingDimensionSlug == dimension.Slug)"
                                            @onclick="() => ResetDimensionAsync(dimension.Slug, dimension.Title)">
                                        @(_resettingDimensionSlug == dimension.Slug ? "Resetting..." : "Restart")
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    [Parameter]
    public string JourneySlug { get; set; } = string.Empty;

    [Parameter]
    public string MilestoneSlug { get; set; } = string.Empty;

    private string? _resetErrorMessage;
    private string? _resetSuccessMessage;
    private string? _resettingDimensionSlug;

    private MilestoneDetailView? _milestone;
    private bool _isLoading = true;
    private string? _errorMessage;
    private Dictionary<string, DimensionProgressRecord> _progressByDimensionSlug =
        new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _startedDimensionSlugs = new(StringComparer.OrdinalIgnoreCase);
    
    private bool IsDimensionInProgress(string dimensionSlug)
    {
        return _startedDimensionSlugs.Contains(dimensionSlug);
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        await AuthService.InitializeAsync();

        if (!AuthService.IsSignedIn)
        {
            var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

            NavigationManager.NavigateTo(
            $"/auth?returnUrl=/{Uri.EscapeDataString(currentPath)}");

            return;
        }

        try
        {
            // Load the milestone details view
            _milestone = await ContentRepository.GetMilestoneDetailBySlugsAsync(
                JourneySlug,
                MilestoneSlug);

            // Load the user's answers for this milestone to determine which dimensions have been started
            var answers = await ReflectionAnswerService.GetAnswersForMilestoneAsync(
                JourneySlug,
                MilestoneSlug);

            _startedDimensionSlugs = answers
                .Where(answer => !string.IsNullOrWhiteSpace(answer.DimensionSlug))
                .Select(answer => answer.DimensionSlug)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var progressRecords = await DimensionProgressService.GetProgressForMilestoneAsync(
                JourneySlug,
                MilestoneSlug);

            _progressByDimensionSlug = progressRecords
                .Where(progress => !string.IsNullOrWhiteSpace(progress.DimensionSlug))
                .GroupBy(progress => progress.DimensionSlug)
                .ToDictionary(
                    group => group.Key,
                    group => group.First(),
                    StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Reset the answers for a specific dimension after user confirmation
    private async Task ResetDimensionAsync(string dimensionSlug, string dimensionTitle)
    {
        _resetErrorMessage = null;
        _resetSuccessMessage = null;

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Restart {dimensionTitle}? This will delete your saved answers for this growth area and start the reflection from the beginning. This will not delete answers from other growth areas.");

        if (!confirmed)
        {
            return;
        }

        try
        {
            _resettingDimensionSlug = dimensionSlug;

            await ReflectionAnswerService.DeleteAnswersForDimensionAsync(
                JourneySlug,
                MilestoneSlug,
                dimensionSlug);
            
            await DimensionProgressService.DeleteProgressForDimensionAsync(
                JourneySlug,
                MilestoneSlug,
                dimensionSlug);

            _startedDimensionSlugs.Remove(dimensionSlug);
            _progressByDimensionSlug.Remove(dimensionSlug);

            _resetSuccessMessage = $"{dimensionTitle} has been reset. You can begin this reflection again.";
        }
        catch (Exception ex)
        {
            _resetErrorMessage = ex.Message;
        }
        finally
        {
            _resettingDimensionSlug = null;
        }
    }

    // Helper methods
    private DimensionProgressRecord? GetDimensionProgress(string dimensionSlug)
    {
        return _progressByDimensionSlug.TryGetValue(dimensionSlug, out var progress)
            ? progress
            : null;
    }

    private bool IsDimensionStarted(string dimensionSlug)
    {
        return GetDimensionProgress(dimensionSlug) is not null
            || _startedDimensionSlugs.Contains(dimensionSlug);
    }

    private string GetDimensionStatusLabel(string dimensionSlug)
    {
        var progress = GetDimensionProgress(dimensionSlug);

        return progress?.Status switch
        {
            "completed" => "Completed",
            "redirected" => "Redirected",
            "needs_guidance" => "Needs Guidance",
            "in_progress" => "In Progress",
            _ when _startedDimensionSlugs.Contains(dimensionSlug) => "In Progress",
            _ => string.Empty
        };
    }

    private string GetDimensionStatusClass(string dimensionSlug)
    {
        var progress = GetDimensionProgress(dimensionSlug);

        return progress?.Status switch
        {
            "completed" => "completed",
            "redirected" => "redirected",
            "needs_guidance" => "needs-guidance",
            "in_progress" => "in-progress",
            _ when _startedDimensionSlugs.Contains(dimensionSlug) => "in-progress",
            _ => string.Empty
        };
    }

    private string GetDimensionActionText(dynamic dimension)
    {
        var progress = GetDimensionProgress(dimension.Slug);

        return progress?.Status switch
        {
            "completed" => "Review Outcome",
            "redirected" => "Review Outcome",
            "needs_guidance" => "Review Guidance",
            "in_progress" => "Continue Reflection",
            _ when _startedDimensionSlugs.Contains(dimension.Slug) => "Continue Reflection",
            _ => $"Reflect on {dimension.Title}"
        };
    }
}