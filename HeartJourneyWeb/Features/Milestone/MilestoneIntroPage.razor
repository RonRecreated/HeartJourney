@page "/journeys/{JourneySlug}/milestones/{MilestoneSlug}/intro"
@using HeartJourney.Core.Features.Milestone
@using HeartJourney.Core.Services.Interfaces
@using HeartJourneyWeb.Services.Auth
@using HeartJourneyWeb.Services.MilestoneProgress
@using HeartJourneyWeb.Components
@using HeartJourneyWeb.Services.JourneyAccess
@using HeartJourneyWeb.Services.Checkout
@using HeartJourneyWeb.Services.Billing
@using HeartJourneyWeb.Helpers
@implements IAsyncDisposable
@inject IBillingService BillingService
@inject IJourneyAccessService JourneyAccessService
@inject ICheckoutService CheckoutService
@inject IJSRuntime JS
@inject IMilestoneProgressService MilestoneProgressService
@inject NavigationManager NavigationManager
@inject IContentRepository ContentRepository
@inject IAuthService AuthService

<PageTitle>@(_intro?.Title ?? "Milestone Intro")</PageTitle>

<section class="milestone-intro-shell @GetMilestoneCssClass(MilestoneSlug)">
    @if (_isLoading)
    {
        <JourneyLoader Message="Preparing your Milestone..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-card">
            <strong>Something went wrong.</strong>
            <p>@_errorMessage</p>
        </div>
    }
    else if (_intro is null)
    {
        <p>Milestone introduction not found.</p>
    }
    else
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_intro.JourneySlug}")">@_intro.JourneyTitle</a>
            <span>/</span>
            <span>@_intro.Title</span>
        </nav>

        <div class="intro-card">
            <div class="step-indicator">
                Step @(_currentStep + 1) of @_steps.Count
            </div>

            @if (_currentStep == 0)
            {
                <p class="eyebrow">A hopeful season</p>
                <h1>@_intro.Title</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.Motto))
                {
                    <p class="motto">@_intro.Motto</p>
                }

                @if (!string.IsNullOrWhiteSpace(_intro.IntroPositiveOutlook))
                {
                    <p class="intro-text">@_intro.IntroPositiveOutlook</p>
                }
                else if (!string.IsNullOrWhiteSpace(_intro.Summary))
                {
                    <p class="intro-text">@_intro.Summary</p>
                }
            }
            else if (_currentStep == 1)
            {
                <p class="eyebrow">What this milestone can help with</p>
                <h1>Practical Readiness</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.IntroHelpsWith))
                {
                    <p class="intro-text">@_intro.IntroHelpsWith</p>
                }
                else
                {
                    <p class="intro-list">
                        This milestone is designed to help you slow down, reflect honestly, and take wise next steps.
                    </p>
                }
            }
            else if (_currentStep == 2)
            {
                <p class="eyebrow">Scripture Anchors</p>
                <h1>Keep these passages close as you evaluate the relationship:</h1>

                @if (IntroBibleVerses.Count == 0)
                {
                    <p class="intro-text">
                        God's Word gives wisdom, correction, encouragement, and hope
                        for every season of life.
                    </p>
                }
                else
                {
                    <div class="verse-list">
                        @foreach (var verse in IntroBibleVerses)
                        {
                            if (verse is null)
                            {
                                continue;
                            }

                            <article class="verse-card">
                                @if (!string.IsNullOrWhiteSpace(verse.Text))
                                {
                                    <p>“@verse.Text”</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(verse.Reference))
                                {
                                    <strong>@verse.Reference</strong>
                                }
                            </article>
                        }
                    </div>
                }
            }
            else if (_currentStep == 3)
            {
                <p class="eyebrow">Pause before continuing</p>
                <h1>Take a moment to pray</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.IntroPrayerInvitation))
                {
                    <p class="intro-text">@_intro.IntroPrayerInvitation</p>
                }
                else
                {
                    <p class="intro-text">
                        Before continuing, pause and ask God for honesty, wisdom,
                        humility, and courage as you reflect.
                    </p>
                }
            }

            <div class="intro-actions">
                @if (!string.IsNullOrWhiteSpace(_checkoutError))
                {
                    <p class="error-card" role="alert">@_checkoutError</p>
                }
                @if (!string.IsNullOrWhiteSpace(_billingMessage))
                {
                    <p class="preview-note" role="status">@_billingMessage</p>
                }
                @if (_currentStep == 3 && !_hasJourneyAccess && _playProduct is not null)
                {
                    <p class="preview-note">Unlock this journey for @_playProduct.Price, one-time through Google Play.</p>
                }
                @if (_currentStep > 0)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="PreviousStep">
                        Back
                    </button>
                }

                @if (_currentStep == _steps.Count - 1)
                {
                    <button type="button"
                            @ref="_purchaseButton"
                            class="milestone-primary-button"
                            disabled="@(_isContinuing || _isConfirmingPurchase || (!_hasJourneyAccess && !_billingReady))"
                            @onclick="ContinueToGrowthAreasAsync">
                        @(_isContinuing
                            ? (_hasJourneyAccess ? "Continuing..." : "Opening Checkout...")
                            : !_hasJourneyAccess
                                ? "Pay to Unlock Journey"
                            : ReviewMode
                                ? "Return to Growth Areas"
                                : "Continue to Growth Areas")
                    </button>
                    @if (!_hasJourneyAccess && _billingProvider == "google_play")
                    {
                        <button type="button" class="secondary-button"
                                disabled="@(_isContinuing || _isConfirmingPurchase || !_billingReady)"
                                @onclick="RestorePlayPurchaseAsync">Restore Google Play purchase</button>
                    }
                    @if (!_hasJourneyAccess && _billingInitialized && !_billingReady)
                    {
                        <button type="button" class="secondary-button" @onclick="RetryBilling">Retry payment setup</button>
                    }
                }
                else
                {
                    <button type="button"
                            class="milestone-primary-button"
                            @onclick="NextStep">
                        Continue
                    </button>
                } 
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public string JourneySlug { get; set; } = string.Empty;

    [Parameter]
    public string MilestoneSlug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "review")]
    public bool ReviewMode { get; set; }

    // PAYWALL PREVIEW: restore card four after authentication, cancellation, or purchase.
    [SupplyParameterFromQuery(Name = "step")]
    public int? RequestedStep { get; set; }
    [SupplyParameterFromQuery(Name = "checkout")]
    public string? CheckoutResult { get; set; }
    private bool _hasJourneyAccess;
    private bool _isConfirmingPurchase;
    private string? _checkoutError;
    private CancellationTokenSource? _accessCheck;
    private ElementReference _purchaseButton;
    private DotNetObjectReference<MilestoneIntroPage>? _billingCallback;
    private string _billingProvider = "unavailable";
    private PlayProduct? _playProduct;
    private bool _billingInitialized;
    private bool _billingReady;
    private string? _billingMessage;
    private int _billingVersion;
    private bool _disposed;

    private MilestoneIntroView? _intro;
    private bool _isLoading = true;
    private bool _isContinuing;
    private string? _errorMessage;
    private int _currentStep;
    
    private IReadOnlyList<HeartJourney.Core.Features.Shared.BibleVerseView> IntroBibleVerses =>
    _intro?.IntroBibleVerses ?? new List<HeartJourney.Core.Features.Shared.BibleVerseView>();

    private readonly List<int> _steps = new() { 0, 1, 2, 3 };

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _currentStep = RequestedStep == 4 ? 3 : 0;
        _hasJourneyAccess = false;
        _checkoutError = null;
        _billingVersion++;
        _billingInitialized = false;
        _billingReady = false;
        _playProduct = null;
        _billingMessage = null;
        _accessCheck?.Cancel();
        _accessCheck?.Dispose();
        _accessCheck = new CancellationTokenSource();

        try
        {
            _intro = await ContentRepository.GetMilestoneIntroBySlugsAsync(
                JourneySlug,
                MilestoneSlug);
            // PAYWALL PREVIEW: signed-out visitors can read all four cards without personal data.
            await AuthService.InitializeAsync();
            if (AuthService.IsSignedIn)
            {
                _hasJourneyAccess = await JourneyAccessService.HasAccessAsync(JourneySlug);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }

        if (!string.IsNullOrEmpty(CheckoutResult) && _intro is not null)
        {
            _currentStep = 3;
            try { await JS.InvokeVoidAsync("localStorage.removeItem", CheckoutReturnRecovery.StorageKey); }
            catch (JSException) { }
            // Confirm access after checkout, but skip polling when checkout was canceled.
            if (CheckoutResult != "cancel" && !_hasJourneyAccess && AuthService.IsSignedIn)
            {
                await ConfirmPurchaseAsync(_accessCheck.Token);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _isLoading || _intro is null || _currentStep != 3) return;
        if (!_billingInitialized && !_hasJourneyAccess)
        {
            _billingInitialized = true;
            var version = _billingVersion;
            try
            {
                var provider = await BillingService.DetectProviderAsync();
                if (_disposed || version != _billingVersion) return;
                _billingProvider = provider;
                if (provider == "unavailable")
                    throw new InvalidOperationException("Google Play billing is unavailable. Please check your connection and retry.");
                if (provider == "google_play" && AuthService.IsSignedIn)
                {
                    var product = await BillingService.PrepareAsync(JourneySlug);
                    if (_disposed || version != _billingVersion) return;
                    _playProduct = product;
                }
                _billingReady = true;
            }
            catch (Exception)
            {
                if (_disposed || version != _billingVersion) return;
                _billingMessage = "Payment setup is unavailable. Please check your connection and retry.";
            }
            StateHasChanged();
        }
        if (_disposed) return;
        if (!_hasJourneyAccess && _billingReady && _playProduct is not null)
        {
            _billingCallback ??= DotNetObjectReference.Create(this);
            await BillingService.BindAsync(_purchaseButton, _billingCallback);
        }
        else
            await BillingService.UnbindAsync(_purchaseButton);
    }

    private void RetryBilling()
    {
        _billingInitialized = false;
        _billingReady = false;
        _billingMessage = null;
    }

    [JSInvokable]
    public Task OnPlayPurchaseStarted()
    {
        _isContinuing = true;
        _checkoutError = null;
        _billingMessage = "Confirming your Google Play purchase...";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task<string> OnPlayPurchaseCompleted(string productId, string purchaseToken)
    {
        try
        {
            var result = await BillingService.VerifyAsync(JourneySlug, productId, purchaseToken);
            _hasJourneyAccess = await JourneyAccessService.HasAccessAsync(JourneySlug);
            _billingMessage = _hasJourneyAccess ? "Your journey is unlocked. Continue when you are ready."
                : result.Status == "pending" ? "Your payment is pending. Use Restore Google Play purchase after payment completes."
                : "Your purchase is being confirmed. Use Restore Google Play purchase before paying again.";
            return _hasJourneyAccess ? "granted" : result.Status;
        }
        catch (Exception ex)
        {
            _checkoutError = ex is InvalidOperationException ? ex.Message
                : "Unable to confirm your purchase. Please try Restore Google Play purchase before paying again.";
            _billingMessage = null;
            return "unconfirmed";
        }
        finally
        {
            _isContinuing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnPlayPurchaseFailed(bool canceled)
    {
        _isContinuing = false;
        _billingMessage = canceled ? "Purchase canceled. You have not unlocked the journey."
            : "The purchase could not be completed. Try Restore Google Play purchase before paying again.";
        return InvokeAsync(StateHasChanged);
    }

    private async Task RestorePlayPurchaseAsync()
    {
        if (_isContinuing) return;
        if (!AuthService.IsSignedIn)
        {
            var path = JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug, fourthCard: true);
            NavigationManager.NavigateTo($"/auth?returnUrl={Uri.EscapeDataString(path)}");
            return;
        }
        _isContinuing = true;
        _checkoutError = null;
        try
        {
            var purchases = await BillingService.ListPurchasesAsync();
            var matching = purchases.Where(p => p.ItemId == _playProduct?.ProductId).ToArray();
            if (matching.Length == 0)
                _billingMessage = "No purchase for this journey was found on the current Google Play account.";
            foreach (var purchase in matching)
                await OnPlayPurchaseCompleted(purchase.ItemId, purchase.PurchaseToken);
        }
        catch (Exception ex)
        {
            _checkoutError = ex is InvalidOperationException ? ex.Message : "Unable to restore purchases. Please try again.";
        }
        finally { _isContinuing = false; }
    }

    private void PreviousStep()
    {
        if (_currentStep > 0)
        {
            _currentStep--;
        }
    }

    private void NextStep()
    {
        if (_currentStep < _steps.Count - 1)
        {
            _currentStep++;
            return;
        }

        NavigationManager.NavigateTo(
            $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}");
    }

    private async Task ContinueToGrowthAreasAsync()
    {
        if (_isContinuing)
        {
            return;
        }

        _isContinuing = true;

        try
        {
            // PAYWALL PREVIEW: recheck ownership before checkout; URL flags never grant access.
            await AuthService.InitializeAsync();
            if (!AuthService.IsSignedIn)
            {
                var returnPath = JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug, fourthCard: true);
                NavigationManager.NavigateTo($"/auth?returnUrl={Uri.EscapeDataString(returnPath)}");
                return;
            }
            _checkoutError = null;
            _hasJourneyAccess = await JourneyAccessService.HasAccessAsync(JourneySlug);
            if (!_hasJourneyAccess)
            {
                // Prepared Play purchases are opened by the native JS click listener.
                // Never send a Play launch to Stripe when billing is unavailable.
                if (_billingProvider != "stripe")
                {
                    _billingMessage = "Please retry payment setup before continuing.";
                    return;
                }
                var returnPath = JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug, fourthCard: true);
                var checkoutUrl = await CheckoutService.CreateCheckoutAsync(JourneySlug, returnPath: returnPath);
                try
                {
                    var pending = new CheckoutReturnRecovery.PendingCheckout(JourneySlug, returnPath, DateTimeOffset.UtcNow);
                    await JS.InvokeVoidAsync("localStorage.setItem", CheckoutReturnRecovery.StorageKey, System.Text.Json.JsonSerializer.Serialize(pending));
                }
                catch (JSException) { }
                NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
                return;
            }

            // Count the visit only when an owner actually enters Growth Areas, never on checkout/cancel.
            if (!ReviewMode)
            {
                await MilestoneProgressService.CompleteIntroVisitAsync(
                    JourneySlug,
                    MilestoneSlug);
            }

            NavigationManager.NavigateTo(
                $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}");
        }
        catch (Exception)
        {
            _checkoutError = "Unable to continue right now. Please refresh the page and try again.";
        }
        finally
        {
            _isContinuing = false;
        }
    }

    private async Task ConfirmPurchaseAsync(CancellationToken cancellationToken)
    {
        _isConfirmingPurchase = true;
        _checkoutError = null;

        try
        {
            await AuthService.InitializeAsync();

            if (!AuthService.IsSignedIn)
            {
                return;
            }

            // Allow a short delay for the payment webhook to grant access.
            for (var attempt = 0; attempt < 5; attempt++)
            {
                _hasJourneyAccess =
                    await JourneyAccessService.HasAccessAsync(
                        JourneySlug,
                        cancellationToken);

                if (_hasJourneyAccess)
                {
                    return;
                }

                if (attempt < 4)
                {
                    await Task.Delay(
                        TimeSpan.FromSeconds(2),
                        cancellationToken);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _checkoutError =
                "Unable to check purchase status. Please refresh the page and try again.";
        }
        finally
        {
            _isConfirmingPurchase = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _accessCheck?.Cancel();
        _accessCheck?.Dispose();
        try { await BillingService.UnbindAsync(_purchaseButton); }
        catch (JSException) { }
        _billingCallback?.Dispose();
    }

    private static string GetMilestoneCssClass(string? milestoneSlug)
    {
        return milestoneSlug?.ToLowerInvariant() switch
        {
            "single" => "milestone-single",
            "talking" => "milestone-talking",
            "courting" => "milestone-courting",
            "engaged" => "milestone-engaged",
            "married" => "milestone-married",
            "divorced" => "milestone-divorced",
            _ => string.Empty
        };
    }
}
