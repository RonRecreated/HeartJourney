@page "/journeys/{JourneySlug}/milestones/{MilestoneSlug}/intro"
@using HeartJourney.Core.Features.Milestone
@using HeartJourney.Core.Services.Interfaces
@using HeartJourneyWeb.Services.Auth
@using HeartJourneyWeb.Services.MilestoneProgress
@using HeartJourneyWeb.Components
@using HeartJourneyWeb.Services.JourneyAccess
@using HeartJourneyWeb.Services.Checkout
@using HeartJourneyWeb.Helpers
@implements IDisposable
@inject IJourneyAccessService JourneyAccessService
@inject ICheckoutService CheckoutService
@inject IJSRuntime JS
@inject IMilestoneProgressService MilestoneProgressService
@inject NavigationManager NavigationManager
@inject IContentRepository ContentRepository
@inject IAuthService AuthService

<PageTitle>@(_intro?.Title ?? "Milestone Intro")</PageTitle>

<section class="milestone-intro-shell @GetMilestoneCssClass(MilestoneSlug)">
    @if (_isLoading)
    {
        <JourneyLoader Message="Preparing your Milestone..." />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-card">
            <strong>Something went wrong.</strong>
            <p>@_errorMessage</p>
        </div>
    }
    else if (_intro is null)
    {
        <p>Milestone introduction not found.</p>
    }
    else
    {
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="@($"/journeys/{_intro.JourneySlug}")">@_intro.JourneyTitle</a>
            <span>/</span>
            <span>@_intro.Title</span>
        </nav>

        <div class="intro-card">
            <div class="step-indicator">
                Step @(_currentStep + 1) of @_steps.Count
            </div>

            @if (_currentStep == 0)
            {
                <p class="eyebrow">A hopeful season</p>
                <h1>@_intro.Title</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.Motto))
                {
                    <p class="motto">@_intro.Motto</p>
                }

                @if (!string.IsNullOrWhiteSpace(_intro.IntroPositiveOutlook))
                {
                    <p class="intro-text">@_intro.IntroPositiveOutlook</p>
                }
                else if (!string.IsNullOrWhiteSpace(_intro.Summary))
                {
                    <p class="intro-text">@_intro.Summary</p>
                }
            }
            else if (_currentStep == 1)
            {
                <p class="eyebrow">What this milestone can help with</p>
                <h1>Practical Readiness</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.IntroHelpsWith))
                {
                    <p class="intro-text">@_intro.IntroHelpsWith</p>
                }
                else
                {
                    <p class="intro-list">
                        This milestone is designed to help you slow down, reflect honestly, and take wise next steps.
                    </p>
                }
            }
            else if (_currentStep == 2)
            {
                <p class="eyebrow">Scripture Anchors</p>
                <h1>Keep these passages close as you evaluate the relationship:</h1>

                @if (IntroBibleVerses.Count == 0)
                {
                    <p class="intro-text">
                        God's Word gives wisdom, correction, encouragement, and hope
                        for every season of life.
                    </p>
                }
                else
                {
                    <div class="verse-list">
                        @foreach (var verse in IntroBibleVerses)
                        {
                            if (verse is null)
                            {
                                continue;
                            }

                            <article class="verse-card">
                                @if (!string.IsNullOrWhiteSpace(verse.Text))
                                {
                                    <p>“@verse.Text”</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(verse.Reference))
                                {
                                    <strong>@verse.Reference</strong>
                                }
                            </article>
                        }
                    </div>
                }
            }
            else if (_currentStep == 3)
            {
                <p class="eyebrow">Pause before continuing</p>
                <h1>Take a moment to pray</h1>

                @if (!string.IsNullOrWhiteSpace(_intro.IntroPrayerInvitation))
                {
                    <p class="intro-text">@_intro.IntroPrayerInvitation</p>
                }
                else
                {
                    <p class="intro-text">
                        Before continuing, pause and ask God for honesty, wisdom,
                        humility, and courage as you reflect.
                    </p>
                }
            }

            <div class="intro-actions">
                @if (!string.IsNullOrWhiteSpace(_checkoutError))
                {
                    <p class="error-card" role="alert">@_checkoutError</p>
                }
                @if (_currentStep > 0)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="PreviousStep">
                        Back
                    </button>
                }

                @if (_currentStep == _steps.Count - 1)
                {
                    <button type="button"
                            class="milestone-primary-button"
                            disabled="@(_isContinuing || _isConfirmingPurchase)"
                            @onclick="ContinueToGrowthAreasAsync">
                        @(_isContinuing
                            ? (_hasJourneyAccess ? "Continuing..." : "Opening Checkout...")
                            : !_hasJourneyAccess
                                ? "Pay to Unlock Journey"
                            : ReviewMode
                                ? "Return to Growth Areas"
                                : "Continue to Growth Areas")
                    </button>
                }
                else
                {
                    <button type="button"
                            class="milestone-primary-button"
                            @onclick="NextStep">
                        Continue
                    </button>
                } 
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public string JourneySlug { get; set; } = string.Empty;

    [Parameter]
    public string MilestoneSlug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "review")]
    public bool ReviewMode { get; set; }

    // PAYWALL PREVIEW: restore card four after authentication, cancellation, or purchase.
    [SupplyParameterFromQuery(Name = "step")]
    public int? RequestedStep { get; set; }
    [SupplyParameterFromQuery(Name = "checkout")]
    public string? CheckoutResult { get; set; }
    private bool _hasJourneyAccess;
    private bool _isConfirmingPurchase;
    private string? _checkoutError;
    private CancellationTokenSource? _accessCheck;

    private MilestoneIntroView? _intro;
    private bool _isLoading = true;
    private bool _isContinuing;
    private string? _errorMessage;
    private int _currentStep;
    
    private IReadOnlyList<HeartJourney.Core.Features.Shared.BibleVerseView> IntroBibleVerses =>
    _intro?.IntroBibleVerses ?? new List<HeartJourney.Core.Features.Shared.BibleVerseView>();

    private readonly List<int> _steps = new() { 0, 1, 2, 3 };

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _currentStep = RequestedStep == 4 ? 3 : 0;
        _hasJourneyAccess = false;
        _checkoutError = null;
        _accessCheck?.Cancel();
        _accessCheck?.Dispose();
        _accessCheck = new CancellationTokenSource();

        try
        {
            _intro = await ContentRepository.GetMilestoneIntroBySlugsAsync(
                JourneySlug,
                MilestoneSlug);
            // PAYWALL PREVIEW: signed-out visitors can read all four cards without personal data.
            await AuthService.InitializeAsync();
            if (AuthService.IsSignedIn)
            {
                _hasJourneyAccess = await JourneyAccessService.HasAccessAsync(JourneySlug);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }

        if (!string.IsNullOrEmpty(CheckoutResult) && _intro is not null)
        {
            _currentStep = 3;
            try { await JS.InvokeVoidAsync("localStorage.removeItem", CheckoutReturnRecovery.StorageKey); }
            catch (JSException) { }
            // Confirm access after checkout, but skip polling when checkout was canceled.
            if (CheckoutResult != "cancel" && !_hasJourneyAccess && AuthService.IsSignedIn)
            {
                await ConfirmPurchaseAsync(_accessCheck.Token);
            }
        }
    }

    private void PreviousStep()
    {
        if (_currentStep > 0)
        {
            _currentStep--;
        }
    }

    private void NextStep()
    {
        if (_currentStep < _steps.Count - 1)
        {
            _currentStep++;
            return;
        }

        NavigationManager.NavigateTo(
            $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}");
    }

    private async Task ContinueToGrowthAreasAsync()
    {
        if (_isContinuing)
        {
            return;
        }

        _isContinuing = true;

        try
        {
            // PAYWALL PREVIEW: recheck ownership before checkout; URL flags never grant access.
            await AuthService.InitializeAsync();
            if (!AuthService.IsSignedIn)
            {
                var returnPath = JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug, fourthCard: true);
                NavigationManager.NavigateTo($"/auth?returnUrl={Uri.EscapeDataString(returnPath)}");
                return;
            }
            _checkoutError = null;
            _hasJourneyAccess = await JourneyAccessService.HasAccessAsync(JourneySlug);
            if (!_hasJourneyAccess)
            {
                var returnPath = JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug, fourthCard: true);
                var checkoutUrl = await CheckoutService.CreateCheckoutAsync(JourneySlug, returnPath: returnPath);
                try
                {
                    var pending = new CheckoutReturnRecovery.PendingCheckout(JourneySlug, returnPath, DateTimeOffset.UtcNow);
                    await JS.InvokeVoidAsync("localStorage.setItem", CheckoutReturnRecovery.StorageKey, System.Text.Json.JsonSerializer.Serialize(pending));
                }
                catch (JSException) { }
                NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
                return;
            }

            // Count the visit only when an owner actually enters Growth Areas, never on checkout/cancel.
            if (!ReviewMode)
            {
                await MilestoneProgressService.CompleteIntroVisitAsync(
                    JourneySlug,
                    MilestoneSlug);
            }

            NavigationManager.NavigateTo(
                $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}");
        }
        catch (Exception)
        {
            _checkoutError = "Unable to continue right now. Please refresh the page and try again.";
        }
        finally
        {
            _isContinuing = false;
        }
    }

    private async Task ConfirmPurchaseAsync(CancellationToken cancellationToken)
    {
        _isConfirmingPurchase = true;
        _checkoutError = null;

        try
        {
            await AuthService.InitializeAsync();

            if (!AuthService.IsSignedIn)
            {
                return;
            }

            // Allow a short delay for the payment webhook to grant access.
            for (var attempt = 0; attempt < 5; attempt++)
            {
                _hasJourneyAccess =
                    await JourneyAccessService.HasAccessAsync(
                        JourneySlug,
                        cancellationToken);

                if (_hasJourneyAccess)
                {
                    return;
                }

                if (attempt < 4)
                {
                    await Task.Delay(
                        TimeSpan.FromSeconds(2),
                        cancellationToken);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _checkoutError =
                "Unable to check purchase status. Please refresh the page and try again.";
        }
        finally
        {
            _isConfirmingPurchase = false;
        }
    }

    public void Dispose()
    {
        _accessCheck?.Cancel();
        _accessCheck?.Dispose();
    }

    private static string GetMilestoneCssClass(string? milestoneSlug)
    {
        return milestoneSlug?.ToLowerInvariant() switch
        {
            "single" => "milestone-single",
            "talking" => "milestone-talking",
            "courting" => "milestone-courting",
            "engaged" => "milestone-engaged",
            "married" => "milestone-married",
            "divorced" => "milestone-divorced",
            _ => string.Empty
        };
    }
}
