@page "/journeys/{JourneySlug}/milestones/{MilestoneSlug}/resume"

@using HeartJourneyWeb.Components.Auth
@using HeartJourneyWeb.Services.MilestoneProgress
@using HeartJourneyWeb.Components
@inject IMilestoneProgressService MilestoneProgressService
@inject NavigationManager NavigationManager
@inject HeartJourneyWeb.Services.Auth.IAuthService AuthService
@inject HeartJourneyWeb.Services.JourneyAccess.IJourneyAccessService JourneyAccessService

@* PAYWALL PREVIEW: this entry route chooses preview or paid resume before creating progress. *@
    <section class="resume-shell">
        <JourneyLoader Message="Preparing your Milestone..." />
    </section>

@code {
    [Parameter]
    public string JourneySlug { get; set; } = string.Empty;

    [Parameter]
    public string MilestoneSlug { get; set; } = string.Empty;

    private bool _hasNavigated;

    protected override async Task OnParametersSetAsync()
    {
        if (_hasNavigated)
        {
            return;
        }

        // PAYWALL PREVIEW: old intro visit counts cannot let an unpaid visitor skip the paywall.
        await AuthService.InitializeAsync();
        if (!AuthService.IsSignedIn || !await JourneyAccessService.HasAccessAsync(JourneySlug))
        {
            _hasNavigated = true;
            NavigationManager.NavigateTo(HeartJourneyWeb.Helpers.JourneyPreviewNavigation.IntroUrl(JourneySlug, MilestoneSlug));
            return;
        }

        var progress = await MilestoneProgressService.GetProgressAsync(
            JourneySlug,
            MilestoneSlug);

        if (progress is null)
        {
            progress = await MilestoneProgressService.StartMilestoneAsync(
                JourneySlug,
                MilestoneSlug);
        }

        _hasNavigated = true;

        if (progress.IntroViewCount < 3)
        {
            NavigationManager.NavigateTo(
                $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}/intro");

            return;
        }

        NavigationManager.NavigateTo(
            $"/journeys/{JourneySlug}/milestones/{MilestoneSlug}");
    }
}
