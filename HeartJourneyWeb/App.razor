<Router AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Features.NotFound)">
    <Found Context="routeData">
        @* PAYWALL PREVIEW: intro/resume are public; all other JourneySlug pages keep the payment guard. *@
        @if (!HeartJourneyWeb.Helpers.JourneyPreviewNavigation.IsPreviewPage(routeData.PageType) &&
            routeData.RouteValues.TryGetValue(
            "JourneySlug", out var journeySlug))
        {
            <RequireJourneyAccess
                JourneySlug="@(journeySlug?.ToString() ?? string.Empty)"
                MilestoneSlug="@(routeData.RouteValues.GetValueOrDefault("MilestoneSlug")?.ToString())"
                @key="routeData">
                <RouteView RouteData="@routeData"
                           DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData"
                                 Selector="h1" />
            </RequireJourneyAccess>
        }
        else
        {
            <RouteView RouteData="@routeData"
                       DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData"
                             Selector="h1" />
        }
    </Found>
</Router>

@* PAYWALL PREVIEW: recover the chosen milestone if the existing checkout function returns to a generic page. *@
<HeartJourneyWeb.Components.CheckoutReturnRecovery />
