diff --git a/HeartJourneyWeb/Components/CheckoutReturnRecovery.razor b/HeartJourneyWeb/Components/CheckoutReturnRecovery.razor
new file mode 100644
--- /dev/null
+++ b/HeartJourneyWeb/Components/CheckoutReturnRecovery.razor
@@ -0,0 +1,38 @@
+@inject IJSRuntime JS
+@inject NavigationManager Navigation
+
+@code {
+    // PAYWALL PREVIEW: a navigation hint only. Stored state never grants paid access.
+    public const string StorageKey = "heartjourney.checkout.preview";
+
+    protected override async Task OnAfterRenderAsync(bool firstRender)
+    {
+        if (!firstRender) return;
+        try
+        {
+            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
+            if (json is null) return;
+            var pending = System.Text.Json.JsonSerializer.Deserialize<PendingCheckout>(json);
+            if (pending is null || string.IsNullOrWhiteSpace(pending.JourneySlug) ||
+                string.IsNullOrWhiteSpace(pending.ReturnPath) ||
+                DateTimeOffset.UtcNow - pending.CreatedAt > TimeSpan.FromMinutes(30) ||
+                pending.CreatedAt > DateTimeOffset.UtcNow.AddMinutes(1))
+            {
+                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
+                return;
+            }
+            var path = new Uri(Navigation.Uri).AbsolutePath;
+            // Recover only generic checkout destinations, leaving other browsing/authentication alone.
+            if (path == "/" || path == "/journeys" || path == $"/journeys/{Uri.EscapeDataString(pending.JourneySlug)}")
+            {
+                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
+                var safePath = HeartJourneyWeb.Helpers.JourneyPreviewNavigation.SafeReturnUrl(pending.ReturnPath);
+                Navigation.NavigateTo(safePath + (safePath.Contains('?') ? "&" : "?") + "checkout=return", replace: true);
+            }
+        }
+        catch (JSException) { /* Explicit checkout URLs still work when browser storage is unavailable. */ }
+        catch (System.Text.Json.JsonException) { /* Ignore invalid browser navigation hints. */ }
+    }
+
+    public sealed record PendingCheckout(string JourneySlug, string ReturnPath, DateTimeOffset CreatedAt);
+}
diff --git a/HeartJourneyWeb/Helpers/JourneyPreviewNavigation.cs b/HeartJourneyWeb/Helpers/JourneyPreviewNavigation.cs
new file mode 100644
--- /dev/null
+++ b/HeartJourneyWeb/Helpers/JourneyPreviewNavigation.cs
@@ -0,0 +1,30 @@
+namespace HeartJourneyWeb.Helpers;
+
+// PAYWALL PREVIEW: shared, explicit navigation rules keep protected pages protected.
+public static class JourneyPreviewNavigation
+{
+    public static bool IsPreviewPage(Type pageType) =>
+        pageType == typeof(Features.Milestone.MilestoneIntroPage) ||
+        pageType == typeof(Features.Milestone.MilestoneResumePage);
+
+    // Only local app paths may be carried through authentication or checkout.
+    public static string SafeReturnUrl(string? path, string fallback = "/journeys")
+    {
+        if (string.IsNullOrWhiteSpace(path)) return fallback;
+        var decoded = path;
+        // Validate encoded paths too, so encoded slashes/backslashes cannot become external redirects.
+        for (var attempt = 0; attempt < 4; attempt++)
+        {
+            if (!decoded.StartsWith('/') || decoded.StartsWith("//") ||
+                decoded.Contains('\\') || decoded.Any(char.IsControl)) return fallback;
+            var next = Uri.UnescapeDataString(decoded);
+            if (next == decoded) return path;
+            decoded = next;
+        }
+        return fallback;
+    }
+
+    public static string IntroUrl(string journeySlug, string milestoneSlug, bool fourthCard = false) =>
+        $"/journeys/{Uri.EscapeDataString(journeySlug)}/milestones/{Uri.EscapeDataString(milestoneSlug)}/intro" +
+        (fourthCard ? "?step=4" : string.Empty);
+}
